---
import { ClientRouter } from 'astro:transitions';
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WaFloat from '../components/WaFloat.astro';
import { site } from '../data/site';
import { baseGraph } from '../lib/schema';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Páginas que no deben aparecer en buscadores (por ejemplo, el 404). */
  noindex?: boolean;
  /** Tipo de página en schema.org. */
  pageType?: 'WebPage' | 'ProfilePage' | 'AboutPage';
  /** Nodos JSON-LD propios de la página (migas de pan, etc.). */
  schema?: Record<string, unknown>[];
}

const { title, description = site.description, noindex = false, pageType = 'WebPage', schema = [] } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.person}, sommelier de habanos en Colombia`;
const origin = Astro.site ?? new URL(Astro.url.origin);
const path = Astro.url.pathname.replace(/(\/index)?(\.html)?\/?$/, '') || '/';
const canonical = new URL(path, origin).href;
const ogImage = new URL(site.ogImage.src, origin).href;

const { ids, nodes } = baseGraph(origin);
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    ...nodes,
    {
      '@type': pageType,
      '@id': `${canonical}#pagina`,
      url: canonical,
      name: fullTitle,
      description,
      inLanguage: site.lang,
      isPartOf: { '@id': ids.website },
      about: { '@id': pageType === 'WebPage' ? ids.business : ids.person },
      ...(pageType === 'ProfilePage' ? { mainEntity: { '@id': ids.person } } : {}),
      primaryImageOfPage: { '@type': 'ImageObject', url: ogImage, width: site.ogImage.width, height: site.ogImage.height },
    },
    ...schema,
  ],
};
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="author" content={site.person} />
    <meta name="geo.region" content={site.country} />
    <meta name="theme-color" content="#0d0907" />
    <meta name="format-detection" content="telephone=no" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <meta property="og:type" content={pageType === 'ProfilePage' ? 'profile' : 'website'} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={String(site.ogImage.width)} />
    <meta property="og:image:height" content={String(site.ogImage.height)} />
    <meta property="og:image:alt" content={site.ogImage.alt} />
    {pageType === 'ProfilePage' && <meta property="profile:first_name" content={site.person} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={site.ogImage.alt} />

    <Font cssVariable="--font-serif" preload />
    <Font cssVariable="--font-sans" preload />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <div class="ambience" aria-hidden="true" transition:persist="ambience"></div>
    <canvas class="field" data-field aria-hidden="true" transition:persist="field"></canvas>
    <div class="veil" aria-hidden="true" transition:persist="veil"></div>
    <canvas class="cigar" data-cigar aria-hidden="true" transition:persist="cigar"></canvas>
    <div class="progress" aria-hidden="true"><span data-progress></span></div>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <div transition:persist="wa"><WaFloat /></div>
    <div class="grain" aria-hidden="true" transition:persist="grain"></div>
    <style is:global>
      .ambience {
        position: fixed;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        background:
          radial-gradient(60vmax 50vmax at 75% 30%, rgba(224, 101, 47, 0.13), transparent 60%),
          radial-gradient(70vmax 60vmax at 10% 90%, rgba(201, 164, 92, 0.08), transparent 60%),
          var(--bg);
      }
      /* Vega de tabaco al fondo, tras un velo oscuro que mantiene el texto legible */
      .field {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100lvh;
        z-index: 0;
        pointer-events: none;
        opacity: 0;
        transition: opacity 2.4s ease;
      }
      .field.is-ready {
        opacity: 0.9;
      }
      .veil {
        position: fixed;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        background:
          linear-gradient(90deg, rgba(13, 9, 7, 0.82) 0%, rgba(13, 9, 7, 0.45) 55%, rgba(13, 9, 7, 0.3) 100%),
          linear-gradient(180deg, rgba(13, 9, 7, 0.55) 0%, transparent 30%, transparent 70%, rgba(13, 9, 7, 0.75) 100%);
      }
      @media (max-width: 860px) {
        .veil {
          background:
            linear-gradient(180deg, rgba(13, 9, 7, 0.45) 0%, rgba(13, 9, 7, 0.55) 45%, rgba(13, 9, 7, 0.85) 100%);
        }
      }
      .cigar {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100lvh;
        z-index: 0;
        pointer-events: none;
        opacity: 0;
        transition: opacity 1.6s ease;
      }
      .cigar.is-ready {
        opacity: var(--cigar-opacity, 1);
        transition: opacity 0.5s ease;
      }
      main,
      .footer {
        position: relative;
        z-index: 1;
      }
      .progress {
        position: fixed;
        inset: 0 0 auto;
        height: 2px;
        z-index: 45;
        pointer-events: none;
      }
      .progress span {
        display: block;
        height: 100%;
        background: linear-gradient(90deg, var(--gold), var(--ember));
        box-shadow: 0 0 12px var(--ember);
        transform: scaleX(0);
        transform-origin: left;
      }
    </style>
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
