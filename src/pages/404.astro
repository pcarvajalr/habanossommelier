---
import Base from '../layouts/Base.astro';
---

<Base title="Página no encontrada" noindex>
  <section class="nf" data-scene="hero">
    <div class="wrap">
      <p class="eyebrow">404</p>
      <h1 data-split data-intro>Esta página se hizo <em>humo</em></h1>
      <a class="btn" href="/">Volver al inicio</a>
    </div>
  </section>
</Base>

<style>
  .nf {
    min-height: 100svh;
    display: grid;
    align-items: center;
  }
  .nf h1 {
    font-size: clamp(3rem, 10vw, 7rem);
    max-width: 10ch;
    margin: 1rem 0 2rem;
  }
  .nf h1 :global(em) {
    color: var(--gold-2);
  }
</style>
