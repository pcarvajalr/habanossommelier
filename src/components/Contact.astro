---
import { site, waLink } from '../data/site';
import WaIcon from './WaIcon.astro';
---

<section id="contacto" class="contact" data-scene="contact" aria-labelledby="contact-title">
  <div class="wrap contact__inner">
    <p class="eyebrow" data-reveal>Contacto</p>
    <h2 id="contact-title" class="contact__title" data-split>Reserva tu <em>experiencia</em></h2>
    <p class="contact__p" data-reveal>
      Asesorías, cursos, catas privadas y eventos. Escríbeme y diseñamos juntos una experiencia a la altura de la ocasión.
    </p>
    <div class="contact__cta" data-reveal>
      <a class="btn btn--solid" href={waLink('Hola Alejandro, quiero reservar una experiencia.')} target="_blank" rel="noopener" data-magnetic>
        <WaIcon size={18} /> Escríbeme por WhatsApp
      </a>
      <a class="btn" href={site.instagram} target="_blank" rel="noopener" data-magnetic>Instagram</a>
    </div>
    <p class="contact__handle" data-reveal>
      <a href={waLink()} target="_blank" rel="noopener">{site.whatsappLabel}</a> · {site.instagramHandle}
    </p>
  </div>
</section>

<style>
  .contact {
    min-height: 100svh;
    display: grid;
    align-items: center;
    padding: 8rem 0;
  }
  .contact__inner {
    display: grid;
    gap: 1.3rem;
    justify-items: start;
  }
  .contact__title {
    font-size: clamp(3rem, 10vw, 8rem);
    line-height: 0.95;
    max-width: 10ch;
  }
  .contact__title :global(em) {
    color: var(--gold-2);
  }
  .contact__p {
    max-width: 44ch;
    color: var(--ink-dim);
    margin: 0;
  }
  .contact__cta {
    margin-top: 0.6rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }
  .contact__handle a {
    color: inherit;
    text-decoration: none;
  }
  .contact__handle {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.4rem;
    color: var(--gold);
    margin: 0;
  }
  @media (max-width: 860px) {
    .contact {
      align-items: end;
    }
  }
</style>
