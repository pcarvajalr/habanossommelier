---
import Photo from './Photo.astro';
import { bio, site } from '../data/site';
import retrato from '../assets/fotos/retrato-sonrisa.jpg';
---

<section id="sobre-mi" class="about" data-scene="about" aria-labelledby="about-title">
  <div class="wrap about__grid">
    <div class="about__photo">
      <Photo
        src={retrato}
        alt={`${site.person} sonriendo con un habano en la mano, en un salón con paredes de madera`}
        ratio="3 / 4"
        position="45% 30%"
        sizes="(max-width: 860px) 92vw, 38vw"
        widths={[400, 640, 828]}
      />
      <p class="about__cap" data-reveal>{site.person} · {site.instagramHandle}</p>
    </div>
    <div class="about__body">
      <p class="eyebrow" data-reveal>Sobre mí</p>
      <h2 id="about-title" class="about__title" data-split>{site.person}</h2>
      <p class="about__role" data-reveal>{site.role}</p>
      <span class="about__line" data-line></span>
      <p class="about__lead" data-scrub-words>{bio.lead}</p>
      {bio.paragraphs.map((p) => <p class="about__p" data-reveal>{p}</p>)}
      <a class="btn" href="/sobre-mi" data-reveal data-magnetic>Leer más</a>
    </div>
  </div>
</section>

<style>
  .about {
    padding: clamp(6rem, 12vw, 10rem) 0;
  }
  .about__grid {
    display: grid;
    grid-template-columns: 0.8fr 1fr;
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: start;
  }
  .about__photo {
    position: sticky;
    top: 7rem;
  }
  .about__cap {
    margin: 0.9rem 0 0;
    font-size: 0.7rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }
  .about__body {
    display: grid;
    gap: 1.1rem;
    justify-items: start;
  }
  .about__title {
    font-size: clamp(3rem, 9vw, 6.5rem);
  }
  .about__role {
    color: var(--gold);
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.1rem, 1rem + 0.6vw, 1.5rem);
    margin: 0;
  }
  .about__line {
    display: block;
    width: min(220px, 50%);
    height: 1px;
    background: var(--gold);
    transform-origin: left;
    margin: 0.6rem 0;
  }
  .about__lead {
    font-family: var(--serif);
    font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.6rem);
    line-height: 1.2;
    margin: 0.4rem 0 0.8rem;
  }
  .about__p {
    color: var(--ink-dim);
    max-width: 58ch;
    margin: 0;
  }
  @media (max-width: 860px) {
    .about__grid {
      grid-template-columns: 1fr;
    }
    .about__photo {
      position: relative;
      top: 0;
      width: min(100%, 420px);
    }
  }
</style>
