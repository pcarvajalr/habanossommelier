---
import { Picture } from 'astro:assets';
import { bio } from '../data/site';
import humo from '../assets/fotos/humo-cerca.jpg';
---

<section class="quote" aria-label="Filosofía">
  <div class="quote__bg" aria-hidden="true">
    <div class="quote__bg-inner" data-parallax="12">
      <Picture src={humo} alt="" widths={[640, 1200, 1800]} sizes="100vw" formats={['avif', 'webp']} loading="lazy" decoding="async" />
    </div>
  </div>
  <div class="wrap quote__inner">
    <span class="quote__mark" aria-hidden="true" data-reveal>“</span>
    <blockquote class="quote__text" data-scrub-words>{bio.closing}</blockquote>
    <p class="quote__by" data-reveal>— Alejandro</p>
  </div>
</section>

<style>
  .quote {
    position: relative;
    padding: clamp(8rem, 16vw, 14rem) 0;
    text-align: center;
    overflow: hidden;
  }
  .quote__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .quote__bg-inner {
    position: absolute;
    inset: -15% 0;
  }
  .quote__bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 30% 40%;
    opacity: 0.32;
    filter: saturate(0.8);
  }
  .quote__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(var(--bg), transparent 25%, transparent 75%, var(--bg)),
      radial-gradient(ellipse at center, rgba(13, 9, 7, 0.35), rgba(13, 9, 7, 0.85));
  }
  .quote__inner {
    position: relative;
  }
  .quote__mark {
    display: block;
    font-family: var(--serif);
    font-size: clamp(6rem, 14vw, 10rem);
    line-height: 0.5;
    color: var(--gold);
    margin-bottom: 1rem;
  }
  .quote__text {
    margin: 0 auto;
    max-width: 22ch;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.9rem, 1.2rem + 3vw, 4rem);
    line-height: 1.15;
  }
  .quote__by {
    margin-top: 2rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    font-size: 0.75rem;
    color: var(--gold);
  }
</style>
