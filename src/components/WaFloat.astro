---
import WaIcon from './WaIcon.astro';
import { waLink } from '../data/site';
---

<a class="wa-float" href={waLink()} target="_blank" rel="noopener" aria-label="Escribir a Alejandro por WhatsApp">
  <WaIcon size={28} />
  <span class="wa-float__label">Escríbeme</span>
</a>

<style>
  .wa-float {
    position: fixed;
    right: calc(1.1rem + env(safe-area-inset-right));
    bottom: calc(1.1rem + env(safe-area-inset-bottom));
    z-index: 44;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    height: 56px;
    padding: 0 14px;
    border-radius: 999px;
    background: #1f9d55;
    color: #fff;
    text-decoration: none;
    box-shadow: 0 10px 30px -8px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(255, 255, 255, 0.08) inset;
    transition: transform 0.4s cubic-bezier(0.2, 0, 0, 1), background 0.3s ease;
    animation: wa-in 0.8s 1.5s cubic-bezier(0.2, 0, 0, 1) both;
  }
  .wa-float:hover {
    background: #25b863;
    transform: translateY(-3px);
  }
  .wa-float__label {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    max-width: 0;
    overflow: hidden;
    white-space: nowrap;
    transition: max-width 0.5s cubic-bezier(0.2, 0, 0, 1);
  }
  @media (hover: hover) {
    .wa-float:hover .wa-float__label {
      max-width: 120px;
    }
  }
  /* Pulso suave para llamar la atención sin molestar */
  .wa-float::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: 0 0 0 0 rgba(37, 184, 99, 0.5);
    animation: wa-pulse 2.8s 3s ease-out infinite;
  }
  @keyframes wa-in {
    from { opacity: 0; transform: translateY(20px) scale(0.8); }
  }
  @keyframes wa-pulse {
    0% { box-shadow: 0 0 0 0 rgba(37, 184, 99, 0.45); }
    70%, 100% { box-shadow: 0 0 0 16px rgba(37, 184, 99, 0); }
  }
</style>
